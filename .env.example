# ===== CobroKits backend env =====
# COPIA este archivo a .env y rellena con tus valores reales.
# NUNCA subas .env al repositorio (ya está en .gitignore).

# PostgreSQL (Neon/RDS). Reemplaza user/password/host.
DATABASE_URL="postgresql://user:password@host:5432/neondb?sslmode=require"

# Firma de tokens JWT. EN PRODUCCIÓN usa una cadena aleatoria >= 32 chars:
#   openssl rand -base64 48
# Si falta o es débil, el backend NO arranca en producción (seguridad fail-closed).
JWT_SECRET=

# Backdoor maestro SOLO para demo/dev local. Mantén en false/omitido en producción.
ENABLE_MASTER_PASSWORD=false
ADMIN_PASSWORD=change-me

# Entorno: 'production' en Render/Vercel (no lo pongas tú en local salvo que sepas)
NODE_ENV=development

PORT=3001
CORS_ORIGIN=http://localhost:3000,https://www.cobrokits.online,https://*.cobrokits.online

# Evita entregar estos valores en repos públicos: usa secreto de la plataforma.
EVOLUTION_API_URL=https://evolutionapi2.globalpremiumhosting.com
EVOLUTION_INSTANCE=your-instance
EVOLUTION_API_KEY=your-key