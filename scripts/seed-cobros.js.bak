require('dotenv').config();
const { Pool } = require('pg');

async function run() {
  const pool = new Pool({ connectionString: process.env.DATABASE_URL, ssl: { rejectUnauthorized: false } });
  await pool.query('SET search_path TO cobrokits,public');
  await pool.query("SET timezone = 'America/Bogota'");
  console.log('🏦 Creando tabla cobros si no existe...');

  await pool.query(`
    CREATE TABLE IF NOT EXISTS cobros (
      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
      name VARCHAR(100) NOT NULL,
      dia INTEGER NOT NULL CHECK (dia BETWEEN 0 AND 6),
      dia_nombre VARCHAR(20) NOT NULL,
      grupo VARCHAR(100) NOT NULL,
      seller_id UUID REFERENCES sellers(id),
      recorrido VARCHAR(200),
      observacion TEXT,
      activo BOOLEAN DEFAULT TRUE,
      created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
      updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
    );
  `);

  // Agregar columnas si falta
  await pool.query(`ALTER TABLE customers ADD COLUMN IF NOT EXISTS cobro_id UUID REFERENCES cobros(id)`).catch(()=>{});
  await pool.query(`ALTER TABLE customer_visits ADD COLUMN IF NOT EXISTS cobro_id UUID REFERENCES cobros(id)`).catch(()=>{});
  await pool.query(`ALTER TABLE payments ADD COLUMN IF NOT EXISTS cobro_id UUID REFERENCES cobros(id)`).catch(()=>{});

  console.log('🧹 Limpiando cobros demo previos...');
  await pool.query(`DELETE FROM cobros WHERE name LIKE 'cobro%viernes' OR name LIKE 'cobro%lunes' OR name LIKE 'cobro%martes' OR name LIKE 'cobro%miercoles' OR name LIKE 'cobro%jueves' OR name LIKE 'cobro%sabado' OR name LIKE 'cobro%domingo' OR name LIKE 'cobro1%' OR name LIKE 'cobro2%' OR name LIKE 'cobro3%'`);

  // Obtener vendedores activos seller role
  const sellersRes = await pool.query(`SELECT id, name FROM sellers WHERE status='active' AND (role='seller' OR role IS NULL) ORDER BY name`);
  let sellers = sellersRes.rows;
  // Filtrar solo los 9 demo + Juan/Maria si existen, si no todos
  const demoSellers = sellers.filter(s => s.name.includes('Méndez') || s.name.includes('Rojas') || s.name.includes('Pérez') || s.name.includes('María') || s.name.includes('Luis') || s.name.includes('Sofia') || s.name.includes('Pedro') || s.name.includes('Camila') || s.name.includes('Molina') || s.name === 'Juan Pérez' || s.name === 'María Gómez');
  if (demoSellers.length >= 9) sellers = demoSellers;
  console.log(`  Vendedores para asignar cobros: ${sellers.length}`);
  sellers.forEach(s=> console.log(`   - ${s.name} ${s.id.slice(0,8)}`));

  const dias = [
    { num: 0, nombre: 'domingo', grupo: 'Grupo Domingo' },
    { num: 1, nombre: 'lunes', grupo: 'Grupo Lunes' },
    { num: 2, nombre: 'martes', grupo: 'Grupo Martes' },
    { num: 3, nombre: 'miercoles', grupo: 'Grupo Miercoles' },
    { num: 4, nombre: 'jueves', grupo: 'Grupo Jueves' },
    { num: 5, nombre: 'viernes', grupo: 'Grupo Viernes' },
    { num: 6, nombre: 'sabado', grupo: 'Grupo Sabado' },
  ];

  const cobros = [];
  let cobroIndex = 0;
  for (const dia of dias) {
    for (let n = 1; n <= 3; n++) {
      const name = `cobro${n}${dia.nombre}`;
      const seller = sellers[(cobroIndex) % sellers.length];
      const recorrido = `Recorrido ${n} - ${dia.grupo} - Zona ${((cobroIndex % 3)+1)}`;
      const observacion = `Cobro ${n} del ${dia.nombre} asignado a ${seller.name}`;
      const res = await pool.query(
        `INSERT INTO cobros (name, dia, dia_nombre, grupo, seller_id, recorrido, observacion, activo) VALUES ($1,$2,$3,$4,$5,$6,$7,TRUE) RETURNING id`,
        [name, dia.num, dia.nombre, dia.grupo, seller.id, recorrido, observacion]
      );
      const cobroId = res.rows[0].id;
      cobros.push({ id: cobroId, name, dia: dia.num, dia_nombre: dia.nombre, grupo: dia.grupo, seller, seller_id: seller.id });
      console.log(`  ✓ ${name} (${dia.grupo}) -> ${seller.name} [${cobroId.slice(0,8)}]`);
      cobroIndex++;
    }
  }

  console.log(`\n✅ Creados ${cobros.length} cobros (3 por día x 7 días)`);

  // Relacionar clientes y ventas existentes con cobros
  // Para cada cobro, buscar clientes cuyo seller_id coincide con el seller del cobro, o asignar si no tienen
  const customersRes = await pool.query(`SELECT id, name, seller_id FROM customers WHERE email LIKE '%@demo.cobrokits' OR seller_id IS NOT NULL`);
  console.log(`\n👥 Asignando clientes a cobros...`);

  for (const cobro of cobros) {
    // Buscar clientes del mismo vendedor del cobro
    let relatedCustomers = customersRes.rows.filter(c => c.seller_id === cobro.seller_id);
    if (relatedCustomers.length === 0) {
      // Si ese vendedor no tiene clientes, tomar 3 al azar
      relatedCustomers = customersRes.rows.sort(()=>0.5-Math.random()).slice(0,3);
      // Reasignar esos clientes al vendedor del cobro
      for (const cli of relatedCustomers) {
        await pool.query(`UPDATE customers SET seller_id=$1, cobro_id=$2 WHERE id=$3`, [cobro.seller_id, cobro.id, cli.id]);
      }
    } else {
      // Asignar cobro_id a 2-3 clientes de ese vendedor (si no tienen)
      const toAssign = relatedCustomers.slice(0, 3);
      for (const cli of toAssign) {
        await pool.query(`UPDATE customers SET cobro_id=$1 WHERE id=$2 AND (cobro_id IS NULL)`, [cobro.id, cli.id]);
      }
    }
    // También asignar visitas existentes de ese vendedor y ese día a este cobro
    // Buscar visitas del vendedor que coincidan con dia del cobro
    const visits = await pool.query(`SELECT id FROM customer_visits WHERE seller_id=$1 AND visit_day=$2 AND (cobro_id IS NULL) LIMIT 2`, [cobro.seller_id, cobro.dia]);
    for (const v of visits.rows) {
      await pool.query(`UPDATE customer_visits SET cobro_id=$1 WHERE id=$2`, [cobro.id, v.id]);
      await pool.query(`UPDATE payments SET cobro_id=$1 WHERE visit_id=$2`, [cobro.id, v.id]);
    }
    if (visits.rowCount === 0) {
      // Si no hay visitas para ese día, crear una visita demo para hoy si el dia coincide con hoy, o dejar para futuro
      // No es necesario, solo log
    }
  }

  // Verificación final
  const counts = await pool.query(`
    SELECT 'cobros' as tabla, count(*)::int as total FROM cobros
    UNION ALL SELECT 'customers con cobro', count(*)::int FROM customers WHERE cobro_id IS NOT NULL
    UNION ALL SELECT 'visits con cobro', count(*)::int FROM customer_visits WHERE cobro_id IS NOT NULL
  `);
  console.table(counts.rows);

  const byDia = await pool.query(`SELECT dia_nombre, count(*)::int as cobros, string_agg(name, ', ' ORDER BY name) as nombres FROM cobros GROUP BY dia, dia_nombre ORDER BY dia`);
  console.log('\n📅 Cobros por día:');
  console.table(byDia.rows);

  const sample = await pool.query(`SELECT c.name, c.dia_nombre, c.grupo, s.name as vendedor, COUNT(cl.id)::int as clientes FROM cobros c LEFT JOIN sellers s ON s.id=c.seller_id LEFT JOIN customers cl ON cl.cobro_id=c.id GROUP BY c.name, c.dia_nombre, c.grupo, s.name ORDER BY c.dia, c.name LIMIT 10`);
  console.log('\n🔗 Sample cobros con clientes:');
  console.table(sample.rows);

  await pool.end();
  console.log('\n✅ Seed cobros completado. Ahora /dashboard/entregar-inventario y /dashboard/config-cobros pueden listar cobros, y /api/cobros devolverá datos.');
}

run().catch(e=>{ console.error(e); process.exit(1)});
